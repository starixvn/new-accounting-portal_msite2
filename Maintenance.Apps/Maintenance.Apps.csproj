    <PackageReference Include="Fanex.Logging.Extensions.AspNetCore" Version="1.1.0" />
    <PackageReference Include="Fanex.Logging.Sentry.RavenClient" Version="2.0.2" />
    <PackageReference Include="Fanex.NAP.Client" Version="2.0.3" />
    <PackageReference Include="Fanex.NAP.SignIn" Version="2.0.4" />
    <PackageReference Include="Fanex.SimpleMailDelivery" Version="1.0.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.5.1" />
    <PackageReference Include="MediatR" Version="13.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="9.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="9.0.7" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.7" />
    <PackageReference Include="ONEbook.UM" Version="3.2.6" />
  </ItemGroup>

 
  <ItemGroup>
    <ProjectReference Include="..\src\Maintenance.DeleteTempVariable\Maintenance.DeleteTempVariable.csproj" />
