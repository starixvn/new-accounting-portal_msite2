<!DOCTYPE html>
<html lang="en" class="linen" ng-app="app">
<head>
	<base href="/">
	<title>@ViewBag.Title</title>
	<link rel="stylesheet" href="css/styles.css">
	<style>		html, body {
			height: 100%
		}

		body {
			margin: 0;
			font-family: Roboto, Helvetica Neue, sans-serif
		}</style>
	<link rel="stylesheet" href="delete-temp/styles.93e9e7f1cb032d4c.css" media="print" onload="this.media='all'">
	<noscript><link rel="stylesheet" href="delete-temp/styles.93e9e7f1cb032d4c.css"></noscript>
</head>
<body>
	<header>
		<div class="logo">
			<a href="~/?ref=logo">mSite2</a>
		</div>
		@{
			Html.RenderPartial("~/Views/Menu.cshtml");
		}
		<div class="user-info">
			<div class="greeting">
				<h2>
					Welcome, @User.Identity.Name
				</h2>
				<ul>
					<li>@Html.ActionLink("Sign Out", "LogOut", "Auth")</li>
				</ul>
			</div>
		</div>
	</header>
	<section>
		<div class="content">
			<app-root>Loading...</app-root>
		</div>
	</section>
	<script src="delete-temp/runtime.210fac5d9693c118.js" type="module"></script>
	<script src="delete-temp/polyfills.d42a8548ce8674e3.js" type="module"></script>
	<script src="delete-temp/main.715ba60f8ff3c0e5.js" type="module"></script>
</body>
</html>